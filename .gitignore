# OS metadata
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Dependencies & build output (committing these breaks Nexus landings)
node_modules/
.env
.env.local
*.log

# Generated by the Next.js / Vitest / Playwright toolchain (S01).
# These must be ignored, not merely untracked: an untracked .next/ is fair game
# for the untracked-file sweep a harness runs between gate attempts, and
# removing it out from under a running dev server is what produces
#   [webpack.cache.PackFileCacheStrategy] Caching failed for pack:
#   ENOENT: rename '.next/cache/webpack/client-development/0.pack.gz_'
.next/
out/
next-env.d.ts
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local runtime state. SPEC-001's boot contract is asserted against an *empty*
# ./data/ on a clean clone, so a committed database would invalidate the very
# thing tests/e2e/boot.spec.ts checks.
data/
