# OS metadata
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Dependencies & build output (committing these breaks Nexus landings)
node_modules/
# `.env` is COMMITTED — it holds non-secret defaults (DATABASE_URL) that the
# Prisma CLI must be able to read on a clean clone; the CLI cannot see
# `.env.local`. See the header in `.env` and DEC-013. `.env.local` holds the
# generated AUTH_SECRET and must never be committed.
.env.local
*.log

# Next.js build output — regenerated by `next dev`/`next build`/`next lint`
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Test artefacts — regenerated by `npm test`
coverage/
playwright-report/
test-results/
.playwright/

# Local runtime state — SPEC-001 puts the SQLite database under ./data/,
# created by `npm run setup` on a clean clone and never committed
data/

# Local media uploads (SPEC-006) — user uploads are ignored, seed fixtures are tracked.
# Order matters: the negation MUST follow the wildcard or public/uploads/seed/ is lost.
public/uploads/*
!public/uploads/seed/
