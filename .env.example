# titan — committed example environment.
#
# `npm run setup` generates `.env.local` from these defaults if it is absent.
# `.env.local` is git-ignored and is the only file that should ever hold a real
# secret. Nothing here is fetched from, or shared with, a third party service:
# the whole product runs as one Node process against a local SQLite file.

# Session signing secret. `npm run setup` replaces this placeholder with 32
# bytes of local CSPRNG output. Never commit a real value.
AUTH_SECRET="replace-me-npm-run-setup-generates-a-real-one"

# Local SQLite database file. The resolved location is `./data/titan.db` at the
# repository root, per SPEC-001 — but the `../` is load-bearing and must not be
# "tidied" to `./`: Prisma resolves a relative sqlite `file:` URL against the
# directory holding `schema.prisma` (`prisma/`), not against the repo root, so
# `file:./data/titan.db` would silently mean `prisma/data/titan.db`. See the
# long note in `.env`, which is the file the Prisma CLI actually reads.
# Created by `npm run db:migrate`; opened in WAL mode by the app connection.
DATABASE_URL="file:../data/titan.db"
