{
  "name": "titan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "setup": "node scripts/setup.mjs",
    "lint": "next lint && tsc --noEmit",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "uploads:seed": "node scripts/uploads-seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.55.1",
    "@types/node": "20.17.11",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "prisma": "6.1.0",
    "tsx": "4.23.12",
    "typescript": "5.7.2",
    "vitest": "4.1.11"
  },
  "eslintConfig": {
    "extends": "next/core-web-vitals",
    "ignorePatterns": [
      "node_modules/",
      ".next/",
      "coverage/",
      "data/",
      "playwright-report/",
      "test-results/"
    ]
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
